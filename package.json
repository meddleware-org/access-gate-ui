{
  "name": "@meddleware/access-gate-ui",
  "version": "0.1.16",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/access-gate/",
  "description": "Operator console for creating and managing on-chain Sui access gates — create gates, configure settings, airdrop NFTs, and freeze gates via a wallet-connected SPA.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/access-gate-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.5",
    "@meddleware/ui": "^0.1.20",
    "@meddleware/nft-gate-client": "^0.0.9",
    "@meddleware/wallet-adapter": "^0.0.7",
    "@mysten/sui": "^2.31.0",
    "@mysten/wallet-standard": "^0.21.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vue-tsc": "~3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
