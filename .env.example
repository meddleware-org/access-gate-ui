# @meddleware/access-gate-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Documentation URL — override to link to a custom or staging docs deployment.
# VITE_DOCS_URL=https://docs.meddleware.co.uk/blockchain/sui/access-gate/

# Developer docs URL — override to link to a custom or staging dev-docs deployment.
# VITE_DEV_URL=https://dev.meddleware.co.uk/sui/access-gate/

# ── Gate-creation policy (operator configuration) ────────────────────────────
# Immutable restrictions recorded on every gate this tool creates (on-chain GatePolicy).
# All default to false (unrestricted).
# VITE_GATE_FREEZE_REQUIRES_UNPAUSED=false   # a paused gate cannot be frozen
# VITE_GATE_LOCK_COMMISSION_ON_FREEZE=false  # freezing locks in the platform commission terms
# VITE_GATE_PAUSE_BLOCKS_DECRYPTION=false    # pausing also blocks Seal decryption
# VITE_GATE_PAUSE_BLOCKS_ACCESS=false        # pausing also blocks pass use (consume, relay uploads)

# Minimum paid gate price. The contract always enforces its own minimum: 10 x the platform's
# minimum commission (PlatformConfig; 0.01 SUI by default). "auto" uses exactly that; an integer
# (MIST) raises the floor further for gates created with this tool.
# VITE_GATE_MIN_PRICE_MIST=auto

# Allow free (price 0) gates. A free gate pays the platform's one-off free-gate fee
# (PlatformConfig; 0.1 SUI by default) when it is created or made free.
# VITE_GATE_ALLOW_FREE=true
